# Supabase Configuration (Frontend & Backend)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_for_seeding_and_migration

# ImageKit Configuration (Frontend & Backend)
VITE_IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
VITE_IMAGEKIT_URL_ENDPOINT=your_imagekit_url_endpoint

# Google Gemini AI Configuration (Backend)
GEMINI_API_KEY=your_gemini_api_key

# WordPress Media Source (Migration)
WORDPRESS_BASE_URL=https://autopavilion.in

# Local database configuration (Optional - defaults are used for Docker setup)
# OLD_WORDPRESS_DB_HOST=127.0.0.1
# OLD_WORDPRESS_DB_PORT=3306
# OLD_WORDPRESS_DB_NAME=autopavilion_migration
# OLD_WORDPRESS_DB_USER=root
# OLD_WORDPRESS_DB_PASSWORD=
